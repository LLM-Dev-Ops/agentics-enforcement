{
  "name": "@agentics/enforcement",
  "version": "0.1.0",
  "description": "Enforcement and contract validation for the Agentics execution topology",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "check:schema-duplication": "node --import tsx scripts/schema-duplication-check.ts",
    "check:contract-imports": "node --import tsx scripts/contract-import-check.ts",
    "check:claims-honesty": "node --import tsx scripts/claims-honesty-check.ts"
  },
  "dependencies": {
    "@agentics/contracts": ">=0.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
